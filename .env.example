# Copy to .env and fill in. Never commit .env.
# The clef backend reads these itself (a nearby .env is loaded if present,
# and does not override variables already set in the environment).

# Workers AI account. Dashboard → Workers AI, or `wrangler whoami`.
CLOUDFLARE_ACCOUNT_ID=

# API token with Account → Workers AI → Read.
# https://developers.cloudflare.com/workers-ai/get-started/rest-api/
CLOUDFLARE_API_TOKEN=

# The Clef model page examples use this name. jev-photo-cull accepts it
# when CLOUDFLARE_API_TOKEN is unset. Do not set both to different tokens.
# CLOUDFLARE_AUTH_TOKEN=

# Optional local decision server (backend `local`). Not contacted by default.
# Ollama: ollama pull clef-flash, then POST /v1/systemone
# JEV_PHOTO_CULL_LOCAL_URL=http://127.0.0.1:11434/v1/systemone
# JEV_PHOTO_CULL_LOCAL_MODEL=clef-flash
# JEV_PHOTO_CULL_LOCAL_PROTOCOL=systemone
# JEV_PHOTO_CULL_LOCAL_IMAGE_FORMAT=raw
